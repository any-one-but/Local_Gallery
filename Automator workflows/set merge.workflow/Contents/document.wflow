				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>setopt null_glob
setopt extended_glob

unique_dest_path() {
  local destdir="$1"
  local name="$2"

  local base ext candidate n
  if [[ "$name" == *.* &amp;&amp; "$name" != .* ]]; then
    base="${name%.*}"
    ext=".${name##*.}"
  else
    base="$name"
    ext=""
  fi

  candidate="$destdir/$base$ext"
  n=2
  while [[ -e "$candidate" ]]; do
    candidate="$destdir/$base ($n)$ext"
    (( n++ ))
  done

  print -r -- "$candidate"
}

unique_dir_path() {
  local parent="$1"
  local name="$2"

  local candidate="$parent/$name"
  local n=2
  while [[ -e "$candidate" ]]; do
    candidate="$parent/$name ($n)"
    (( n++ ))
  done

  print -r -- "$candidate"
}

make_dir() {
  local path="$1"
  /bin/mkdir -p -- "$path" || return 1
  print -r -- "$path"
}

normalize_folder_base() {
  local name="$1"

  name="${name%.*}"
  name="${name%_[0-9]##}"

  [[ -n "$name" ]] || name="Merged Items"
  print -r -- "$name"
}

choose_output_name() {
  local -a sources=("$@")
  local -a names=()
  local src item

  for src in "${sources[@]}"; do
    [[ -d "$src" ]] || continue
    src="${src:A}"
    for item in "$src"/*(DN); do
      names+=("${item:t}")
    done
  done

  if (( ${#names[@]} == 0 )); then
    print -r -- "Merged Items"
    return 0
  fi

  local first
  first="$(printf '%s\n' "${names[@]}" | LC_ALL=C /usr/bin/sort -fV | /usr/bin/head -n 1)"
  [[ -n "$first" ]] || first="Merged Items"
  normalize_folder_base "$first"
}

move_with_collision_rename() {
  local src="$1"
  local destdir="$2"
  local name="${src:t}"
  local dest="$destdir/$name"

  /bin/mkdir -p -- "$destdir" || return 1

  if [[ -e "$dest" ]]; then
    dest="$(unique_dest_path "$destdir" "$name")"
  fi

  /bin/mv -- "$src" "$dest"
}

targets=("$@")
(( ${#targets[@]} == 0 )) &amp;&amp; exit 0

typeset -a folders=()
for t in "${targets[@]}"; do
  [[ -d "$t" ]] &amp;&amp; folders+=("${t:A}")
done
(( ${#folders[@]} == 0 )) &amp;&amp; exit 0

out_parent="${folders[1]:h}"
desired_base="$(choose_output_name "${folders[@]}")"

tmp_base="${desired_base} (Merging)"
tmp_path="$(unique_dir_path "$out_parent" "$tmp_base")" || exit 1
out_dir="$(make_dir "$tmp_path")" || exit 1

for f in "${folders[@]}"; do
  for item in "$f"/*(DN); do
    move_with_collision_rename "$item" "$out_dir" || exit 1
  done
done

for f in "${folders[@]}"; do
  /bin/rmdir -- "$f" 2&gt;/dev/null || /bin/rm -rf -- "$f"
done

final_path="$out_parent/$desired_base"
if [[ "$out_dir" != "$final_path" ]]; then
  if [[ -e "$final_path" ]]; then
    final_path="$(unique_dir_path "$out_parent" "$desired_base")"
  fi
  /bin/mv -- "$out_dir" "$final_path" 2&gt;/dev/null || true
fi

exit 0
</string>
