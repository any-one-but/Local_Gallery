{
  "name": "local_gallery",
  "version": "01.06.00",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "npm run sync:split && electron .",
    "build:singlefile": "node scripts/generate-singlefile-html.js",
    "sync:split": "node scripts/generate-singlefile-html.js --from-singlefile",
    "watch:singlefile": "node scripts/generate-singlefile-html.js --watch",
    "release:patch": "node scripts/release-patch.js",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/any-one-but/Local_Gallery.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/any-one-but/Local_Gallery/issues"
  },
  "homepage": "https://github.com/any-one-but/Local_Gallery#readme",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "productName": "Local_Gallery",
    "appId": "com.anyonebut.localgallery",
    "files": [
      "**/*",
      "!dist/**",
      "!Releases/**",
      "!*.dmg",
      "!*.zip"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
