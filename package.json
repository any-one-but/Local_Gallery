{
  "name": "local_gallery",
  "version": "01.07.69",
  "description": "Local Gallery -- a local media library viewer, as a Mac app (Electron).",
  "scripts": {
    "prestart": "node scripts/build-auth-helper.js",
    "start": "electron .",
    "predev": "node scripts/build-auth-helper.js",
    "dev": "electron .",
    "prebuild": "node scripts/build-auth-helper.js",
    "build": "electron-builder --mac",
    "predist": "node scripts/build-auth-helper.js",
    "dist": "electron-builder --mac",
    "check:look": "node scripts/check-look.js",
    "release:patch": "node scripts/release-patch.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/any-one-but/Local_Gallery.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/any-one-but/Local_Gallery/issues"
  },
  "homepage": "https://github.com/any-one-but/Local_Gallery#readme",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.anyonebut.localgallery",
    "productName": "Local Gallery",
    "extraMetadata": {
      "version": "1.7.69"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "!electron/native/**",
      "frontend/**",
      "tauri-bridge.js",
      "tauri-fs-shim.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "dist-native/LocalGalleryAuth.app",
        "to": "LocalGalleryAuth.app"
      },
      {
        "from": "dist-native/lg-touchid.node",
        "to": "lg-touchid.node"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "identity": "-",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Local Gallery shows the library in your Documents folder."
      },
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Local Gallery_${version}_${arch}.dmg"
    }
  }
}
