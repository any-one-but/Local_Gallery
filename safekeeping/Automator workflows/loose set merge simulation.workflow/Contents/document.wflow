						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>setopt null_glob numeric_glob_sort
LC_COLLATE=C

is_system_file() {
  local n=$1
  case "$n" in
    .DS_Store|Thumbs.db|desktop.ini|Desktop.ini|Icon$'\r') return 0 ;;
    *) return 1 ;;
  esac
}

dirs=("$@")
if [[ ${#dirs[@]} -eq 0 ]]; then
  dirs=(.)
fi

typeset -i failures=0

for dir in "${dirs[@]}"; do
  [[ -d "$dir" ]] || continue

  typeset -a subdirs
  subdirs=("$dir"/*(/N))
  subdirs=("${(on)subdirs[@]}")

  for sub in "${subdirs[@]}"; do
    typeset -a files
    files=("$sub"/*(.N))
    files=("${(on)files[@]}")

    newname=""
    for f in "${files[@]}"; do
      base=${f:t}
      is_system_file "$base" &amp;&amp; continue

      # Take part before first underscore, or whole name if no underscore
      if [[ "$base" == *_* ]]; then
        prefix="${base%%_*}"
      else
        prefix="$base"
      fi

      # Strip extension if it looks like a normal file extension
      if [[ "$prefix" == *.* &amp;&amp; "$prefix" != .* ]]; then
        newname="${prefix%.*}"
      else
        newname="$prefix"
      fi

      # We only need the first valid file's processed name
      break
    done

    [[ -n "$newname" ]] || continue

    new="$dir/$newname"
    [[ "$sub" == "$new" ]] &amp;&amp; continue

    if [[ -e "$new" ]]; then
      print -u2 "name collision: $new already exists (cannot rename $sub)"
      failures=1
      continue
    fi

    mv -- "$sub" "$new" || failures=1
  done
done

exit $failures</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
