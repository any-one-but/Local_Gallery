				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>setopt null_glob numeric_glob_sort
LC_COLLATE=C

dirs=("$@")
if [[ ${#dirs[@]} -eq 0 ]]; then
  dirs=(.)
fi

for dir in "${dirs[@]}"; do
  [[ -d "$dir" ]] || continue
  parent=${dir:t}

  typeset -a subdirs
  subdirs=("$dir"/*(/N))
  subdirs=("${(on)subdirs[@]}")

  for sub in "${subdirs[@]}"; do
    name=${sub:t}
    # Skip if it already starts with parent followed by " - "
    [[ "$name" == "${parent} - "* ]] &amp;&amp; continue
    new="$dir/${parent} - ${name}"
    if [[ "$sub" != "$new" ]]; then
      mv -n -- "$sub" "$new"
    fi
  done
done</string>
					<key>CheckedForUserDefaultShell</key>
