					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh
setopt null_glob
setopt extended_glob

err() { print -u2 -- "$*"; }

choose_folder_name_from_selection() {
  local -a items=("$@")
  local -a names=()
  local t first base cleaned

  for t in "${items[@]}"; do
    names+=("${t:t}")
  done

  if (( ${#names[@]} == 0 )); then
    print -r -- "New Folder"
    return 0
  fi

  first="$(printf '%s\n' "${names[@]}" | LC_ALL=C /usr/bin/sort -fV | /usr/bin/head -n 1)"
  [[ -n "$first" ]] || first="New Folder"

  # Remove first underscore and everything after it
  if [[ "$first" == *_* ]]; then
    cleaned="${first%%_*}"           # everything before the FIRST underscore
  else
    cleaned="$first"
  fi

  # Strip extension (only if it looks like a normal file extension)
  if [[ "$cleaned" == *.* &amp;&amp; "$cleaned" != .* ]]; then
    base="${cleaned%.*}"
  else
    base="$cleaned"
  fi

  [[ -n "$base" ]] || base="New Folder"
  print -r -- "$base"
}

targets=("$@")
(( ${#targets[@]} == 0 )) &amp;&amp; exit 0

# Resolve to absolute paths; keep only existing items
typeset -a items=()
for t in "${targets[@]}"; do
  [[ -e "$t" ]] &amp;&amp; items+=("${t:A}")
done
(( ${#items[@]} == 0 )) &amp;&amp; exit 0

# Require a single parent directory for all selected items
out_parent="${items[1]:h}"
for t in "${items[@]}"; do
  if [[ "${t:h}" != "$out_parent" ]]; then
    err "Selected items must be in the same folder."
    exit 1
  fi
done

folder_base="$(choose_folder_name_from_selection "${items[@]}")"
final_path="$out_parent/$folder_base"

# Create temporary folder
tmp_dir="$(/usr/bin/mktemp -d "$out_parent/.grouping_tmp.XXXXXX")" || {
  err "Failed to create temporary folder."
  exit 1
}

# Move items without renaming or overwriting
for src in "${items[@]}"; do
  /bin/mv -n -- "$src" "$tmp_dir/" || {
    err "Move failed (possible name collision or permissions issue): ${src:t}"
    exit 1
  }
done

# Final rename (now guaranteed to be free)
if [[ -e "$final_path" ]]; then
  err "Cannot rename folder to '$folder_base' because something already exists with that name."
  exit 1
fi

/bin/mv -- "$tmp_dir" "$final_path" || {
  err "Failed to rename folder to '$folder_base'."
  exit 1
}

exit 0</string>
					<key>CheckedForUserDefaultShell</key>
